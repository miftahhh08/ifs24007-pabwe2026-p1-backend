PORT=4000
DB_PATH=gulasadar.db
CORS_ORIGIN=*
# Opsional: aktifkan chatbot AI dan identifikasi foto. JANGAN commit key asli.
# Gemini punya tier gratis (aistudio.google.com). Bila keduanya diisi, Gemini dipakai.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=

# Database online (Turso) untuk deploy di Vercel. Kosongkan untuk memakai file SQLite lokal (DB_PATH).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Zona waktu pencatatan harian (jam dari UTC). Default 7 = WIB.
# TZ_OFFSET_HOURS=7
